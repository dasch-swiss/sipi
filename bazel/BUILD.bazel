# `kakadu_extension.bzl`'s `gh_release_archive` call takes `kakadu.BUILD.bazel`
# as its `build_file` argument via a `//bazel:kakadu.BUILD.bazel` label, so it
# needs an explicit `exports_files` entry to be loadable from outside this
# package. The other native-`cc_library` overlays (exiv2, jansson, mimalloc,
# jbigkit, lcms2, tiff, tracy) need no such entry: their `build_file` labels
# are wired up directly in `MODULE.bazel`, which — being the module root —
# can reference package-internal files without an `exports_files` grant.
exports_files(["kakadu.BUILD.bazel"])

# Per-tool binutils from the prebuilt LLVM bundle, version-matched to the
# toolchain (LLVM 22), selected by the *exec* platform: the debug-split genrule (`//src:sipi_debug_
# split`, Linux-only) needs llvm-objcopy/llvm-readelf, and `just bazel-coverage`
# needs llvm-cov/llvm-profdata version-matched to the instrumented `.profraw`
# (a host LLVM 19 profdata cannot read an LLVM 22 profile). The Linux branches
# cover CI's two arches; the darwin default keeps `bazel build //...` resolving
# on macOS (where the genrule is incompatible-skipped and coverage uses the
# darwin bundle). Bumping LLVM_VERSION means updating the bundle names here and
# in MODULE.bazel (ADR-0014 policy).
alias(
    name = "llvm-objcopy",
    actual = select({
        "//platforms:is_linux_x86_64": "@llvm-toolchain-minimal-linux-amd64//:bin/llvm-objcopy",
        "//platforms:is_linux_aarch64": "@llvm-toolchain-minimal-linux-arm64//:bin/llvm-objcopy",
        "//conditions:default": "@llvm-toolchain-minimal-darwin-arm64//:bin/llvm-objcopy",
    }),
    visibility = ["//src:__pkg__"],
)

alias(
    name = "llvm-readelf",
    actual = select({
        "//platforms:is_linux_x86_64": "@llvm-toolchain-minimal-linux-amd64//:bin/llvm-readelf",
        "//platforms:is_linux_aarch64": "@llvm-toolchain-minimal-linux-arm64//:bin/llvm-readelf",
        "//conditions:default": "@llvm-toolchain-minimal-darwin-arm64//:bin/llvm-readelf",
    }),
    visibility = ["//src:__pkg__"],
)

# Public: the coverage recipe `bazel build`s this and then locates the
# binary via `bazel cquery --output=files` (justfile lines ~99-102) rather
# than depending on it from a BUILD file, so there is no label edge for
# visibility to narrow against — this is a command-line-only consumer.
alias(
    name = "llvm-cov",
    actual = select({
        "//platforms:is_linux_x86_64": "@llvm-toolchain-minimal-linux-amd64//:bin/llvm-cov",
        "//platforms:is_linux_aarch64": "@llvm-toolchain-minimal-linux-arm64//:bin/llvm-cov",
        "//conditions:default": "@llvm-toolchain-minimal-darwin-arm64//:bin/llvm-cov",
    }),
    visibility = ["//visibility:public"],
)

# Public for the same reason as `:llvm-cov` above: the coverage recipe
# resolves its path via `bazel cquery --output=files`, a command-line-only
# consumer with no BUILD-file label edge to narrow against.
alias(
    name = "llvm-profdata",
    actual = select({
        "//platforms:is_linux_x86_64": "@llvm-toolchain-minimal-linux-amd64//:bin/llvm-profdata",
        "//platforms:is_linux_aarch64": "@llvm-toolchain-minimal-linux-arm64//:bin/llvm-profdata",
        "//conditions:default": "@llvm-toolchain-minimal-darwin-arm64//:bin/llvm-profdata",
    }),
    visibility = ["//visibility:public"],
)

# Consumed by the sanitizer CI job and local sanitizer runs to symbolize
# ASan/LSan reports (`sipi+0xOFFSET` frames) — required for the name-based
# suppressions in `.lsan_suppressions.txt` to match symbolized frames.
# e2e test targets attach this as a `data` dep under `:asan_enabled` and point
# `ASAN_SYMBOLIZER_PATH` at its runfiles path, so the symbolizer travels with
# the test and resolves whether it runs on the runner or the RBE worker.
alias(
    name = "llvm-symbolizer",
    actual = select({
        "//platforms:is_linux_x86_64": "@llvm-toolchain-minimal-linux-amd64//:bin/llvm-symbolizer",
        "//platforms:is_linux_aarch64": "@llvm-toolchain-minimal-linux-arm64//:bin/llvm-symbolizer",
        "//conditions:default": "@llvm-toolchain-minimal-darwin-arm64//:bin/llvm-symbolizer",
    }),
    visibility = ["//test/e2e:__pkg__"],
)

# True whenever `--config=asan` (i.e. `--@llvm//config:asan=true`) is in effect.
# Lets test targets attach the LLVM symbolizer as a runfile only under the
# sanitizer build, so non-sanitizer runs don't drag it into their closure.
config_setting(
    name = "asan_enabled",
    flag_values = {"@llvm//config:asan": "true"},
    visibility = ["//test/e2e:__pkg__"],
)

# glibc 2.42 → 2.31 ABI compatibility shims. See glibc23_compat.c for
# the full rationale. Linked into //src, //src/format_handlers, and
# //src/image on Linux only (see the `linkopts` selectors there).
load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "glibc23_compat",
    srcs = ["glibc23_compat.c"],
    visibility = ["//src:__subpackages__"],
    target_compatible_with = ["@platforms//os:linux"],
    # `_GNU_SOURCE` is also #defined inside the .c file, but spelling it
    # out here ensures the macro is visible to any tooling that
    # introspects the cc_library's `defines`.
    defines = ["_GNU_SOURCE"],
)
