# Local patches applied via `single_version_override(patches = …)` (BCR modules)
# or `http_archive(patches = …)` in `//MODULE.bazel`. Each `.patch` file targets
# one module or archive and is documented inline with the upstream issue /
# exit condition. The root package is the only consumer of these labels, so
# root-package visibility is sufficient.
exports_files(
    glob(["*.patch"]),
    visibility = ["//:__pkg__"],
)
