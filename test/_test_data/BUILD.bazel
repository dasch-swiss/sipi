"""Test fixture data consumed by Bazel-driven unit + approval tests.

Filegroups expose subtrees under `test/_test_data/` so individual `cc_test`
targets can declare just the data they need rather than the whole tree.
The Bazel-set `TEST_SRCDIR/TEST_WORKSPACE` cwd is the workspace root in
runfiles; a test reading these files looks at workspace-relative paths
like `test/_test_data/images/unit/lena512.jp2` (see `test/test_paths.h`
for the env-var-driven path resolution).
"""

package(default_visibility = ["//:__pkg__", "//src:__subpackages__", "//test:__subpackages__"])

# Image fixtures consumed by Bazel-driven tests. `images/thumbs/**` is
# excluded because it's a write-only target dir under CMake; under Bazel
# every test routes writes to TEST_TMPDIR via `sipi::test::tmp_dir()`.
filegroup(
    name = "images",
    srcs = glob(
        ["images/**/*"],
        exclude = ["images/thumbs/**"],
        allow_empty = True,
    ),
)

# Fuzz seed inputs for the codec fuzz harnesses (`//src/format_handlers/fuzz`,
# DEV-7066): one named filegroup per format, each pairing the smallest-valid
# fixture with crafted-malformed fixtures already exercised by that codec's
# unit/approval tests. Consumed indirectly through `//src/format_handlers/corpus/<fmt>`,
# which layers these onto the (currently empty) per-package glob that
# `fuzz-corpus-merge` grows over time. These fixtures are Git LFS.
filegroup(
    name = "fuzz_seeds_tiff",
    srcs = [
        "images/malformed/tiff_colormap_unsupported_bps.tif",
        "images/malformed/tiff_icc_garbage.tif",
        "images/malformed/tiff_oversized_dimensions.tif",
        "images/malformed/tiff_palette_1bit.tif",
        "images/malformed/tiff_transferfunction_grayscale.tif",
        "images/unit/exif_lens_specification.tif",
    ],
)

filegroup(
    name = "fuzz_seeds_jpeg",
    srcs = [
        "images/malformed/jpeg_exif_truncated.jpg",
        "images/malformed/jpeg_icc_no_description.jpg",
        "images/malformed/jpeg_icc_short_app2.jpg",
        "images/malformed/jpeg_photoshop_overshoot_app13.jpg",
        "images/malformed/jpeg_photoshop_short_app13.jpg",
        "images/malformed/jpeg_xmp_truncated.jpg",
        "images/unit/HasCommentBlock.JPG",
    ],
)

filegroup(
    name = "fuzz_seeds_png",
    srcs = [
        "images/unit/mario.png",
    ],
)

filegroup(
    name = "fuzz_seeds_j2k",
    srcs = [
        "images/malformed/j2k_exif_truncated.jp2",
        "images/malformed/j2k_oversized_dimensions.jp2",
        "images/malformed/palette_undersized_lut.jp2",
        "images/unit/gray_with_icc.jp2",
        "images/unit/ycbcr16.jpx",
    ],
)

# Every test-data file under this package — consumed by `//:test_fixtures`
# which the Rust e2e suite materialises into runfiles and surfaces as
# `SIPI_REPO_ROOT`. `repo_root()` traverses arbitrary sub-paths
# (`<root>/test/_test_data/images/unit/lena512.jp2`,
# `<root>/test/_test_data/jwt-keys/...`, etc.), so the filegroup must be
# all-encompassing rather than path-specific. `images/thumbs/**` is the
# CMake write-only target dir; tests under Bazel route writes to
# `TEST_TMPDIR` instead, so it stays excluded here too.
filegroup(
    name = "all_test_data",
    srcs = glob(
        ["**/*"],
        exclude = ["images/thumbs/**"],
        allow_empty = False,
    ),
)
