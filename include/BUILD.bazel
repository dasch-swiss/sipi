"""Sipi build-time inputs that have no dedicated module.

The `include/` directory holds the generated-config templates consumed by
`expand_template` (`SipiVersion.h.in`, `SipiConfig.h.in`) and the ICC
profile binaries embedded as C arrays by the `//src:<profile>_icc_h`
genrules. Each is exported individually below; there is no bundled
`cc_library` here.
"""

package(default_visibility = ["//src:__pkg__"])

# Individual file labels — e.g. expand_template's `template` argument
# accepts a single Label, not a target that bundles multiple files.
exports_files([
    "SipiVersion.h.in",
    "SipiConfig.h.in",
    # ICC profile binaries embedded as C arrays at build time by the
    # `//src:<profile>_icc_h` genrules via `//tools:bin2c`. Kept with the
    # CMake build's exact filenames (.icc / .icm extensions preserved).
    "ICC-Profiles/AdobeRGB1998.icc",
    "ICC-Profiles/Rec709-Rec1886.icc",
    "ICC-Profiles/USWebCoatedSWOP.icc",
    "ICC-Profiles/YCC709.icm",
])
