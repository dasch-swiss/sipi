    {
      "type": "text", "id": "legend", "x": 60, "y": 1035, "width": 660, "height": 54,
      "text": "node = Bazel library target · n f = source files · LOC = lines of its own srcs/hdrs\narrow = direct dependency, pointing at the thing depended on\nlight blue = Rust · dark blue = C++ · purple = Lua runtime · pale strip = foundation",
      "originalText": "node = Bazel library target · n f = source files · LOC = lines of its own srcs/hdrs\narrow = direct dependency, pointing at the thing depended on\nlight blue = Rust · dark blue = C++ · purple = Lua runtime · pale strip = foundation",
      "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 500007, "version": 1, "versionNonce": 500107, "isDeleted": false,
