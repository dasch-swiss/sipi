"""src/iiifparser/ — IIIF URL component parsers (per-module carve, DEV-6353).

The pure-CPU front door that turns the region/size/rotation/quality/format/
identifier path segments of an IIIF URL into validated value objects
(`SipiRegion`, `SipiSize`, `SipiRotation`, `SipiQualityFormat`,
`SipiIdentifier`, `SipiDecodeDims`). A leaf of the engine graph: it depends
only on `SipiError` (`//src:sipi_top`) and the string helpers in `//src/util`,
never on `SipiImage` or any codec. Carved out of `//src:engine` so the
image engine deps this narrow parser rather than housing it, and so the
colocated `:iiifparser_test` links the parser alone.

`strip_include_prefix = "/src"` exposes the headers at the path-prefixed form
(`#include "iiifparser/SipiSize.h"`) for cross-module consumers
(`SipiImage.h`, `SipiIO.h`, `serve_image.cpp`) without relying on a consumer's
`includes = ["."]`. Siblings inside the package use the quote-form
(`#include "SipiSize.h"`), which auto-searches the current source's directory.

Source, tests, and the regression corpus are colocated per ADR-0003.
"""

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//src:__subpackages__"])

cc_library(
    name = "iiifparser",
    srcs = [
        "SipiDecodeDims.cpp",
        "SipiIdentifier.cpp",
        "SipiQualityFormat.cpp",
        "SipiRegion.cpp",
        "SipiRotation.cpp",
        "SipiSize.cpp",
    ],
    hdrs = [
        "SipiDecodeDims.h",
        "SipiIdentifier.h",
        "SipiQualityFormat.h",
        "SipiRegion.h",
        "SipiRotation.h",
        "SipiSize.h",
    ],
    copts = ["-fexceptions"],
    strip_include_prefix = "/src",
    deps = [
        "//src:sipi_top",
        "//src/util",
    ],
)

# The C++ `parse_iiif_uri` request classifier (`handlers::iiif_handler`). The
# Rust shell owns IIIF parsing in production (`server-rs/src/iiif.rs`, a faithful
# port of this classifier); this C++ code is now only the reference the port's
# unit + approval + corpus tests check against, so it is `testonly` and out of
# `//src:sipi_lib` — folded here (DUNE-014) from the retired `src/handlers/`
# package so the classifier lives beside the IIIF component parsers it classifies
# into. `strip_include_prefix` exposes it at `#include "iiifparser/iiif_handler.h"`.
cc_library(
    name = "iiif_handler",
    srcs = ["iiif_handler.cpp"],
    hdrs = ["iiif_handler.h"],
    strip_include_prefix = "/src",
    testonly = True,
    # //test/approval:approvaltests exercises the same classifier; the colocated
    # tests below reach it in-package.
    visibility = ["//test/approval:__pkg__"],
    deps = ["//src/util"],
)

# Colocated unit tests (ADR-0003). The IIIF value-object parsers + the seam
# round-trip + decode-dim computation, linking the narrow `:iiifparser`.
cc_test(
    name = "iiifparser_test",
    srcs = [
        "decode_dims_test.cpp",
        "seam_roundtrip_test.cpp",
        "sipiidentifier_test.cpp",
        "sipiqualityformat_test.cpp",
        "sipiregion_test.cpp",
        "sipirotation_test.cpp",
        "sipisize_test.cpp",
    ],
    deps = [
        ":iiifparser",
        "@googletest//:gtest_main",
    ],
)

# Colocated regression suite for the `parse_iiif_uri` classifier + its corpus
# (originally the libFuzzer seed corpus; the fuzz harness was retired with the
# oracle, ADR-0020). `SIPI_FUZZ_CORPUS_DIR` is the workspace-relative path the
# test resolves through the runfiles tree (cc_test cwd = workspace root).
cc_test(
    name = "iiif_handler_test",
    srcs = [
        "iiif_handler_test.cpp",
        "parse_iiif_uri_corpus_test.cpp",
    ],
    data = ["//src/iiifparser/corpus:seed_corpus"],
    local_defines = ['SIPI_FUZZ_CORPUS_DIR=\\"src/iiifparser/corpus\\"'],
    deps = [
        ":iiif_handler",
        "@googletest//:gtest_main",
    ],
)

# Parse tier microbenchmark — IIIF URL component string parsers. Pure CPU, no
# fixtures. Co-located with the module per ADR-0003 (moved from //src). Built
# only by `just bench` (`tags = ["manual"]`, dep of no test).
cc_binary(
    name = "parse_benchmark",
    srcs = ["parse_benchmark.cpp"],
    tags = ["manual"],
    testonly = True,
    deps = [
        ":iiifparser",
        "@google_benchmark//:benchmark_main",
    ],
)
