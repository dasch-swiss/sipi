"""src/image_processing — free-function pixel operators over `SipiImage`.

Geometry, colour/channel, and watermark/arithmetic operators that used to be
`SipiImage` methods, re-expressed as free functions taking `SipiImage &` as
their first parameter. This package depends one-way on `//src/image` (it
reads and mutates a `SipiImage` through its public accessor surface — never
its protected members) and `//src/image` never depends back: a facade method
that forwarded to a free function here would reintroduce the cycle the
extraction is meant to remove.

This package also declares (and `Sipi::processing::add_watermark` calls)
`Sipi::read_watermark`; the definition lives in `//src/format_handlers`
(`SipiIOTiff.cpp`, which uses libtiff) and is resolved at link time from
whichever binary links both packages — the same link-time-resolution trick
`src/image/BUILD.bazel` documents for `SipiImage::io`. This package must
never gain a dependency on `//src/format_handlers` (the reverse edge — since
`format_handlers` already depends on `image_processing` for the pixel
operators — would cycle).

`include_prefix = "image_processing"` + `strip_include_prefix =
"/src/image_processing/cpp"` exposes the header at `#include
"image_processing/processing.h"` for cross-package consumers; the sibling
`resample.cc` includes `resample.h` with the bare quote form.

Default visibility is `//src:__subpackages__`: this package is internal to
the `src` tree. The `:image_processing` library additionally grants
`//test/approval:__pkg__` because `processing.h` is included directly from
`test/approval/` sources, which sit outside `//src/...`. Visibility narrows
who may depend on this package; it cannot express the one-way rule against
`//src/image` described above (both packages sit inside `//src:__subpackages__`),
so that constraint stays enforced by dep-set review, not by this file.
"""

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//src:__subpackages__"])

cc_library(
    name = "image_processing",
    srcs = [
        "cpp/color.cpp",
        "cpp/compose.cpp",
        "cpp/geometry.cpp",
        "cpp/resample.cc",
    ],
    hdrs = [
        "cpp/processing.h",
        "cpp/resample.h",
    ],
    include_prefix = "image_processing",
    strip_include_prefix = "/src/image_processing/cpp",
    copts = ["-fexceptions"],
    # //test/approval:approvaltests includes processing.h directly; the
    # colocated targets below reach it in-package.
    visibility = ["//src:__subpackages__", "//test/approval:__pkg__"],
    deps = [
        "//src/error",
        "//src/image",
        "//src/logging:logging",
        "//src/metadata:metadata",
        "//src/metadata/cpp/internal:icc_lcms2",
        "//src/observability:observability",
        "//src/util",
        "@highway//:hwy",
        "@lcms2//:lcms2",
    ],
)

# Process tier — the image-processing operators between decode and encode
# (scale/rotate/crop/to8bps/convertToIcc/removeChannel). Uses existing small
# repo fixtures via the `//test/_test_data:images` filegroup — not blocked on
# the benchmark fixture archive. Co-located with the module per ADR-0003. The
# `env` applies under `bazel run`; `just bench` exports the same variables
# when exec'ing the binary directly (SOURCE_DATE_EPOCH pins the wall-clock-
# stamped ICC creation date on the convertToIcc path per ADR-0002;
# SIPI_WORKSPACE_ROOT resolves fixtures via `//test:test_paths`).
cc_binary(
    name = "process_benchmark",
    srcs = ["cpp/process_benchmark.cpp"],
    data = ["//test/_test_data:images"],
    env = {
        "SIPI_WORKSPACE_ROOT": ".",
        "SOURCE_DATE_EPOCH": "946684800",
    },
    tags = ["manual"],
    testonly = True,
    visibility = ["//visibility:private"],
    deps = [
        ":image_processing",
        "//src:sipi_lib",
        "//test:test_paths",
        "@google_benchmark//:benchmark_main",
    ],
)

# Colocated unit tests (ADR-0003): the resample/scale filter, the channel-count
# and equality/pixel-delta regression suite, the buffer-overflow and crop
# guards, and the engine-direct IIIF region/size/rotation/quality transform
# matrix. Two source files decode real JP2/TIFF fixtures through `SipiImage`,
# so this target — unlike the `:image_processing` library it exercises —
# depends on `//src/format_handlers` for the codec dispatch.
cc_test(
    name = "image_processing_test",
    srcs = [
        "cpp/channel_count_regression_test.cpp",
        "cpp/equality_regression_test.cpp",
        "cpp/iiif_transform_matrix_test.cpp",
        "cpp/overflow_regression_test.cpp",
        "cpp/pixel_delta_regression_test.cpp",
        "cpp/scale_resample_test.cpp",
    ],
    data = ["//test/_test_data:images"],
    env = {"SIPI_WORKSPACE_ROOT": "."},
    visibility = ["//visibility:private"],
    deps = [
        ":image_processing",
        "//src/error",
        "//src/format_handlers:format_handlers",
        "//test:test_paths",
        "@googletest//:gtest_main",
    ],
)
