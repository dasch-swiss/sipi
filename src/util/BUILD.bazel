"""util — generic SIPI-domain utilities (parsing, hashing, errors).

Generic helpers — MIME/string parsing, file hashing, filename-to-subdirectory
hashing, the shttps error type — that are SIPI-domain rather than HTTP
transport, kept as a leaf package so the boundary is a build-graph invariant.
External dependencies are OpenSSL (Hash's EVP digest context) and libmagic
(Parsing's MIME sniffing plus the embedded `magic.mgc` database); the one
internal dep is `//src/logging` (SipiFilenameHash's log_debug calls).

`include_prefix = "util"` + `strip_include_prefix = "/src/util/cpp"` exposes
the headers at the path-prefixed form `#include "util/Parsing.h"` (ADR-0003)
self-sufficiently — no reliance on a consumer's `includes = ["."]`. Siblings
within the package use the bare quote form (`#include "Error.h"`).
"""

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//bazel:magic_database.bzl", "magic_mgc_header")

package(default_visibility = ["//src:__subpackages__"])

# Embeds libmagic's `magic.mgc` database as a C array consumed by
# `Parsing.cpp` (`magic_load_buffers(magic_mgc, magic_mgc_len, …)`) so SIPI
# binaries ship the magic database in-binary. Reached as
# `#include "util/generated/magic_mgc.h"` via strip_include_prefix.
magic_mgc_header(
    name = "magic_mgc_h",
    mgc = "@libmagic//:magic.mgc",
    out = "cpp/generated/magic_mgc.h",
)

cc_library(
    name = "util",
    srcs = [
        "cpp/Error.cpp",
        "cpp/Hash.cpp",
        "cpp/Parsing.cpp",
        "cpp/SipiFilenameHash.cpp",
        "cpp/UrlDecode.cpp",
    ],
    hdrs = [
        "cpp/Error.h",
        "cpp/Global.h",
        "cpp/Hash.h",
        "cpp/Parsing.h",
        "cpp/PathRedact.h",
        "cpp/SipiFilenameHash.h",
        "cpp/UrlDecode.h",
        "cpp/checked_arith.h",
        ":magic_mgc_h",
    ],
    include_prefix = "util",
    strip_include_prefix = "/src/util/cpp",
    deps = [
        # Hash.h's EVP_MD_CTX digest context (SHA via OpenSSL EVP).
        "@openssl//:crypto",
        # Parsing's libmagic MIME sniffing + the embedded magic database.
        "@libmagic//:lib",
        # SipiFilenameHash.cpp's log_debug calls.
        "//src/logging:logging",
    ],
)

# Co-located unit tests (ADR-0003): Hash, Parsing, PathRedact,
# SipiFilenameHash, and urldecode. Each depends only on the util library, so
# a forbidden cross-module include shows up as a build error rather than
# slipping through a `:sipi_lib`-wide dep.
cc_test(
    name = "util_test",
    srcs = [
        "cpp/hash_test.cpp",
        "cpp/parsing_test.cpp",
        "cpp/path_redact_test.cpp",
        "cpp/sipifilenamehash_test.cpp",
        "cpp/urldecode_test.cpp",
    ],
    deps = [
        ":util",
        "@googletest//:gtest_main",
    ],
)

# checked_arith.h is header-only with no matching .cpp in :util, so its test
# gets its own cc_test rather than folding into util_test above.
cc_test(
    name = "checked_arith_test",
    srcs = ["cpp/checked_arith_test.cpp"],
    deps = [
        ":util",
        "@googletest//:gtest_main",
    ],
)
