"""src/scripting/rust — the Rust-hosted Lua runtime (ADR-0023).

Hosts the Lua VM behind the preflight hooks, the configured Lua routes, the
docroot `.lua`/`.elua` pages, and the Lua config parse, built on mlua
(`lua53` + `serde`; `mlua-sys` feature `external`) linked against the BCR
`@lua` 5.3.6 `cc_library` — the same interpreter the C++ side links, one
symbol set in the final binary. Colocated component-first / language-second
with the C++ `//src/scripting` package (the ADR-0021 pattern).
"""

load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//src:__subpackages__"])

# The C++ stdlib link bracket — same shape as //src/server-rs (see its
# docstring): any target that performs a FINAL link of the C++ engine
# archives under rustc's C linker driver needs libc++ linked explicitly.
# The rust_library itself only produces an rlib; the rust_test/rust_binary
# targets below do link.
_CPP_STDLIB_LINK = select({
    "@platforms//os:macos": [
        "-Clink-arg=-lc++",
    ],
    "@platforms//os:linux": [
        "-Clink-arg=-Wl,-Bstatic",
        "-Clink-arg=-lc++",
        "-Clink-arg=-lc++abi",
        "-Clink-arg=-lunwind",
        "-Clink-arg=-Wl,-Bdynamic",
    ],
    "//conditions:default": [],
})

# The runtime crate: VM factory (hardened profile, deadline hook, binding
# chokepoint), limits/kill accounting, and the bytecode cache. `@lua` is a
# direct dep — mlua's `external` mode emits no link inputs of its own, so the
# interpreter symbols come from the same BCR cc_library the C++ side links
# (one symbol set in the final binary).
rust_library(
    name = "scripting",
    srcs = [
        "bindings/config.rs",
        "bindings/helpers.rs",
        "bindings/image.rs",
        "bindings/mod.rs",
        "bindings/server.rs",
        "bindings/sqlite.rs",
        "engine_ffi.rs",
        "entry.rs",
        "lib.rs",
        "limits.rs",
        "runtime.rs",
    ],
    crate_name = "scripting",
    crate_root = "lib.rs",
    edition = "2021",
    deps = [
        "@crates//:base64",
        "@crates//:httpdate",
        "@crates//:jsonwebtoken",
        "@crates//:libc",
        "@crates//:mlua",
        "@crates//:rand",
        "@crates//:reqwest",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tracing",
        # The narrow C FFI seam → the transitive C++ image engine, for the
        # sipi_image_* handle family (engine_ffi.rs). @lua stays a direct dep
        # (mlua external mode emits no link inputs of its own).
        "//src/ffi:sipi_ffi",
        "@lua",
        # The sqlite C API for the `sqlite` binding (thin hand-written FFI —
        # see bindings/sqlite.rs for why not libsqlite3-sys).
        "@sqlite3",
    ],
    # Excluded from the sanitizer build like //src/server-rs:lib: the crate
    # carries the transitive C++ engine dep whose source trips the missing
    # <sanitizer/*.h> header under --config=asan.
    tags = ["no-sanitizer"],
)

# Inline #[cfg(test)] unit tests (limits/deadline/kill accounting).
rust_test(
    name = "scripting_test",
    crate = ":scripting",
    edition = "2021",
    rustc_flags = _CPP_STDLIB_LINK,
    tags = ["no-sanitizer"],
)

# Runtime-profile tests: whitelist invariants, limit enforcement (pcall
# included), restricted require, bytecode cache, binding chokepoint.
rust_test(
    name = "runtime_test",
    srcs = ["runtime_tests.rs"],
    edition = "2021",
    deps = [
        ":scripting",
        "@crates//:mlua",
        "@crates//:tempfile",
    ],
    rustc_flags = _CPP_STDLIB_LINK,
    tags = ["no-sanitizer"],
)

# Per-request Lua VM cost (manual, `-c opt`, never CI-gated).
rust_binary(
    name = "runtime_benchmark",
    testonly = True,
    srcs = ["runtime_benchmark.rs"],
    data = [
        "//config:configs",
        "//scripts:all_scripts",
    ],
    edition = "2021",
    rustc_flags = _CPP_STDLIB_LINK,
    tags = [
        "manual",
        "no-sanitizer",
    ],
    deps = [":scripting"],
)

# Binding-surface tests: field parity, result shapes, json/uuid/jwt
# semantics, requireAuth quirks, the fs table, an in-process http mock, and
# the chokepoint enumeration over every binding table.
rust_test(
    name = "bindings_test",
    srcs = ["bindings_tests.rs"],
    edition = "2021",
    deps = [
        ":scripting",
        "@crates//:base64",
        "@crates//:jsonwebtoken",
        "@crates//:mlua",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
    rustc_flags = _CPP_STDLIB_LINK,
    tags = ["no-sanitizer"],
)

# LuaEnv entry-point tests: boot probes (fail-closed init) + the preflight
# return-shape matrix.
rust_test(
    name = "entry_test",
    srcs = ["entry_tests.rs"],
    edition = "2021",
    rustc_flags = _CPP_STDLIB_LINK,
    tags = ["no-sanitizer"],
    deps = [
        ":scripting",
        "@crates//:tempfile",
    ],
)

# SipiImage-binding tests over the real engine — the seam probes for the
# sipi_image_* handle ABI, driven from Lua. Links the engine (Kakadu et al.),
# so it needs the C++ stdlib bracket and is sanitizer-excluded.
rust_test(
    name = "image_test",
    srcs = ["image_tests.rs"],
    data = ["//test/_test_data:images"],
    edition = "2021",
    rustc_flags = _CPP_STDLIB_LINK,
    tags = ["no-sanitizer"],
    deps = [
        ":scripting",
        "@crates//:mlua",
        "@crates//:tempfile",
        "@rules_rust//rust/runfiles",
    ],
)

# Lua config-parse tests: the shipped config/sipi.config.lua resolves to the
# expected values (the former //test/unit/configuration coverage) plus the
# schema semantics (defaults, deprecated keys, strict types, required routes).
rust_test(
    name = "config_parse_test",
    srcs = ["config_parse_tests.rs"],
    data = ["//config:configs"],
    edition = "2021",
    deps = [
        ":scripting",
        "@crates//:tempfile",
        "@rules_rust//rust/runfiles",
    ],
    rustc_flags = _CPP_STDLIB_LINK,
    tags = ["no-sanitizer"],
)

# Pins the mlua ↔ `@lua` external-link contract: VM creation, chunk exec,
# integer-width ABI, `set_memory_limit`, the instruction-count hook, and the
# `panic=unwind` build profile mlua's callback boundary requires. `@lua` is a
# direct dep — with `external`, mlua-sys emits no link inputs of its own.
rust_test(
    name = "mlua_external_link_test",
    srcs = ["mlua_external_link_test.rs"],
    edition = "2021",
    deps = [
        "@crates//:mlua",
        "@lua",
    ],
    rustc_flags = _CPP_STDLIB_LINK,
    tags = ["no-sanitizer"],
)
