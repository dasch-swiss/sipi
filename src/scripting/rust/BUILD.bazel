"""src/scripting/rust — the Rust-hosted Lua runtime (ADR-0023).

Hosts the Lua VM behind the preflight hooks, the configured Lua routes, the
docroot `.lua`/`.elua` pages, and the Lua config parse, built on mlua
(`lua53` + `serde`; `mlua-sys` feature `external`) linked against the BCR
`@lua` 5.3.6 `cc_library` — the same interpreter the C++ side links, one
symbol set in the final binary. Colocated component-first / language-second
with the C++ `//src/scripting` package (the ADR-0021 pattern).
"""

load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//src:__subpackages__"])

# The runtime crate: VM factory (hardened profile, deadline hook, binding
# chokepoint), limits/kill accounting, and the bytecode cache. `@lua` is a
# direct dep — mlua's `external` mode emits no link inputs of its own, so the
# interpreter symbols come from the same BCR cc_library the C++ side links
# (one symbol set in the final binary).
rust_library(
    name = "scripting",
    srcs = [
        "entry.rs",
        "lib.rs",
        "limits.rs",
        "runtime.rs",
    ],
    crate_name = "scripting",
    crate_root = "lib.rs",
    edition = "2021",
    deps = [
        "@crates//:libc",
        "@crates//:mlua",
        "@crates//:tracing",
        "@lua",
    ],
)

# Inline #[cfg(test)] unit tests (limits/deadline/kill accounting).
rust_test(
    name = "scripting_test",
    crate = ":scripting",
    edition = "2021",
)

# Runtime-profile tests: whitelist invariants, limit enforcement (pcall
# included), restricted require, bytecode cache, binding chokepoint.
rust_test(
    name = "runtime_test",
    srcs = ["runtime_tests.rs"],
    edition = "2021",
    deps = [
        ":scripting",
        "@crates//:mlua",
        "@crates//:tempfile",
    ],
)

# Lua config-parse tests: the shipped config/sipi.config.lua resolves to the
# expected values (the former //test/unit/configuration coverage) plus the
# schema semantics (defaults, deprecated keys, strict types, required routes).
rust_test(
    name = "config_parse_test",
    srcs = ["config_parse_tests.rs"],
    data = ["//config:configs"],
    edition = "2021",
    deps = [
        ":scripting",
        "@crates//:tempfile",
        "@rules_rust//rust/runfiles",
    ],
)

# Pins the mlua ↔ `@lua` external-link contract: VM creation, chunk exec,
# integer-width ABI, `set_memory_limit`, the instruction-count hook, and the
# `panic=unwind` build profile mlua's callback boundary requires. `@lua` is a
# direct dep — with `external`, mlua-sys emits no link inputs of its own.
rust_test(
    name = "mlua_external_link_test",
    srcs = ["mlua_external_link_test.rs"],
    edition = "2021",
    deps = [
        "@crates//:mlua",
        "@lua",
    ],
)
