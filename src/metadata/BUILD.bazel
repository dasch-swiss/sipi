"""src/metadata/ — image metadata + colour profile surface (Y+8a per DEV-6353).

Second per-module Bazel package promotion (after //src/observability).
Houses SIPI's EXIF (`Exif`), IPTC (`Iptc`), XMP (`Xmp`), and ICC
(`Icc`) wrappers around exiv2 / lcms2, plus the Essentials packet
(`Essentials`) sidecar serialization. Headers were lifted from
`include/metadata/` per ADR-0003 so `.cpp`, `.h`, and `*_test.cpp` live
co-located.

The byte-mutation helper `apply_icc_header_normalization` lives in
`//src/metadata/cpp/internal:icc_normalization` per DEV-6406 — the canonical
Test seam pattern. Its visibility is restricted to `//src/metadata:__pkg__`
at the Bazel analysis level, replacing today's comment-as-policy header
with a build-graph invariant. The co-located `icc_normalize_test`
exercises the helper through the same restricted edge.

This package no longer depends on `SipiImage`: the one coupling — `Icc`'s
`iccFormatter(SipiImage*)` plus `SipiImage`'s `friend class Icc` (DEV-6396) —
was inverted so `iccFormatter` takes the pixel shape (`bps`/`nc`/`photo`) by
value and the `PhotometricInterpretation` enum lives here in
`photometric_interpretation.h`. Metadata now sits cleanly *below* the image
engine (`SipiImage` is owned by `//src/image`), depending only on
`//src/error` for `SipiError`. `layering_check`/`parse_headers` stay
deferred to the global DEV-6353 flip.

`include_prefix = "metadata"` + `strip_include_prefix = "/src/metadata/cpp"`
exposes the headers at the path-prefixed form `#include "metadata/icc.h"` for
cross-module consumers; siblings inside this package use the quote-form
(`#include "icc.h"`).
"""

load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//src:__subpackages__"])

# Essentials packet wire format (ADR-0005 / DEV-6410). `cc_proto_library` is
# consumed only by `//src/metadata/cpp/internal:protobuf_codec`;
# every other translation unit talks to the codec via the `EssentialsFields`
# struct in `essentials.h` so `essentials.pb.h` stays out of the public ABI.
proto_library(
    name = "essentials_proto",
    srcs = ["cpp/essentials.proto"],
)

cc_proto_library(
    name = "essentials_cc_proto",
    deps = [":essentials_proto"],
)

cc_library(
    name = "metadata",
    srcs = [
        "cpp/essentials.cpp",
        "cpp/exif.cpp",
        "cpp/icc.cpp",
        "cpp/iptc.cpp",
        "cpp/xmp.cpp",
    ],
    hdrs = [
        "cpp/essentials.h",
        "cpp/exif.h",
        "cpp/icc.h",
        "cpp/iptc.h",
        "cpp/photometric_interpretation.h",
        "cpp/xmp.h",
    ],
    include_prefix = "metadata",
    strip_include_prefix = "/src/metadata/cpp",
    # `-ldl` / `-lpthread` propagate to every consumer at link time:
    # exiv2 + sentry (transitive deps of `:icc` and `:exif`) call into
    # libdl + libpthread directly. //src:sipi_lib declares these for its
    # own consumers, but cc_tests that link `:metadata` standalone
    # (e.g. essentials_test) don't go through `:sipi_lib`, so the
    # linkopts must live here too. Linux-only; macOS folds dl/pthread
    # into libSystem.
    linkopts = select({
        "@platforms//os:linux": [
            "-ldl",
            "-lpthread",
        ],
        "//conditions:default": [],
    }),
    deps = [
        "@exiv2//:exiv2",
        "@lcms2//:lcms2",
        "@openssl//:crypto",
        "@openssl//:ssl",
        "//src/util",
        "//src:sipi_generated_hdrs",
        "//src/error",
        "//src/logging:logging",
        "//src/metadata/cpp/internal:icc_normalization",
        "//src/metadata/cpp/internal:protobuf_codec",
    ],
)

# Co-located unit test per ADR-0003 — moved from test/unit/sipiicc/.
# Tests Sipi::detail::apply_icc_header_normalization directly with explicit
# epochs, so unlike //test/approval:approvaltests this target does NOT need
# to set SOURCE_DATE_EPOCH.
cc_test(
    name = "icc_normalize_test",
    srcs = [
        "cpp/icc_normalize_test.cpp",
        "cpp/test_main.cpp",
    ],
    deps = [
        "//src/metadata/cpp/internal:icc_normalization",
        "@googletest//:gtest_main",
    ],
)

# Co-located unit test for the public Essentials factory surface (DEV-6410).
# Depends on the internal codec only to author wire bytes for the
# 5 ParseError variants — production callers go through `Essentials::parse`
# (protobuf) or `Essentials::parse_legacy` (pipe-delimited).
cc_test(
    name = "essentials_test",
    srcs = ["cpp/essentials_test.cpp"],
    deps = [
        ":metadata",
        "//src/metadata/cpp/internal:protobuf_codec",
        "@googletest//:gtest_main",
    ],
)

# Co-located unit test for the EXIF rational-array read path (DEV-6537).
# Decodes a real TIFF fixture through `SipiIOTiff::read()`, so this target
# depends on `//src/format_handlers` and `//src/image` for the codec dispatch
# alongside `:metadata` for `Exif`.
cc_test(
    name = "exif_rational_test",
    srcs = ["cpp/exif_rational_regression_test.cpp"],
    data = ["//test/_test_data:images"],
    env = {"SIPI_WORKSPACE_ROOT": "."},
    deps = [
        ":metadata",
        "//src/format_handlers:format_handlers",
        "//src/image",
        "//test:test_paths",
        "@googletest//:gtest_main",
    ],
)
