"""//src/cli/cpp/commands — one file per `sipi <verb> <noun>` subcommand.

Layout follows the Clap-community convention (cargo / jj / uv / deno):
each leaf subcommand has its own `.cpp` / `.h` named after the command
path, with the entry-point function named `cmd_<command_path>`. Tests
live co-located with their command per ADR-0003.

Today's commands:

  * `sipi convert service-file` → `convert_service_file.{h,cpp}` →
    `cmd_convert_service_file(ConvertServiceFileArgs)`
  * `sipi convert access-file`  → `convert_access_file.{h,cpp}`  →
    `cmd_convert_access_file(ConvertAccessFileArgs)`
  * `sipi verify [access-file|service-file]` → `verify.{h,cpp}` →
    `cmd_verify(VerifyArgs)`
  * `sipi health` → `health.{h,cpp}` → `cmd_health(HealthArgs)`

`decode_deadline.{h,cpp}` is not a command: it is the deadline-bounded
decode every offline verb (the commands above plus `query` / `convert` /
`compare` in `//src/cli:cli_app`) reads its input through.

The `:commands` cc_library is consumed by `//src/cli:sipi` (the binary
target) and by `:commands_test` (the co-located unit tests).

`include_prefix = "cli/commands"` + `strip_include_prefix =
"/src/cli/cpp/commands"` exposes the headers at the path-prefixed form
`#include "cli/commands/convert_access_file.h"` self-sufficiently
(ADR-0003).
"""

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//src/cli:__pkg__"])

cc_library(
    name = "commands",
    srcs = [
        "convert_access_file.cpp",
        "convert_service_file.cpp",
        "decode_deadline.cpp",
        "health.cpp",
        "verify.cpp",
    ],
    hdrs = [
        "convert_access_file.h",
        "convert_service_file.h",
        "decode_deadline.h",
        "health.h",
        "verify.h",
    ],
    include_prefix = "cli/commands",
    strip_include_prefix = "/src/cli/cpp/commands",
    copts = ["-fexceptions"],
    deps = [
        "//src:sipi_lib",
        # convert_access_file.cpp's JSON report emitter.
        "//src/cli:sipi_report",
        # decode_deadline.cpp's run_with_deadline (the seam's decode watchdog).
        "//src/ffi:sipi_ffi",
        # convert_access_file.cpp / convert_service_file.cpp's rotate calls.
        "//src/image_processing",
    ],
)

# Co-located unit tests for each subcommand (DEV-6537),
# per ADR-0003. The tests exercise `cmd_*` functions directly plus the
# SipiImage / SipiIOTiff plumbing they call into, so `:sipi_lib` is a
# direct dep alongside `:commands`.
#
# Fixture paths resolve via `//test:test_paths`, which honours
# `SIPI_WORKSPACE_ROOT` and `TEST_TMPDIR`.
cc_test(
    name = "commands_test",
    srcs = [
        "convert_access_file_test.cpp",
        "convert_service_file_test.cpp",
        "health_test.cpp",
        "verify_test.cpp",
    ],
    data = ["//test/_test_data:images"],
    env = {"SIPI_WORKSPACE_ROOT": "."},
    deps = [
        ":commands",
        "//src:sipi_lib",
        "//test:test_paths",
        "@googletest//:gtest_main",
    ],
)
