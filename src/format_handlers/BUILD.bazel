"""src/format_handlers/ — image codec handlers (per-module carve, DEV-6353).

The four `SipiIO` implementations (TIFF, JPEG2000, JPEG, PNG) plus the shared
`output_sink`, wrapping libtiff / Kakadu / libjpeg-turbo / libpng. Each handler
reads a codec into a `SipiImage` and writes one back out, so it depends on the
full image surface in `//src/image` (`SipiImage`, `SipiIO`, `SipiImageError`).

Cycle inversion: `SipiImage` and the concrete handlers reference each other
(SipiImage dispatches read/write through the `io` registry; the handlers touch
SipiImage internals as `friend`s). A Bazel package cannot depend on itself, so
this package depends one-way on `//src/image`, and the `SipiImage::io`
registry definition was moved OUT of the image package into `format_registry.cpp`
here. `//src/image` references `io`; the linker resolves it from this package,
which every final link pulls in via `//src:sipi_lib` and `//src/ffi:sipi_ffi`.

This package also depends one-way on `//src/image_processing`: `SipiIOTiff.cpp`
*defines* `Sipi::read_watermark`, which `image_processing` *declares* and calls
from `add_watermark` — the same link-time-resolution asymmetry as `io`, mirrored.
`//src/image_processing` must never depend back on this package (see its own
BUILD docstring).

`include_prefix = "format_handlers"` + `strip_include_prefix = "/src/format_handlers/cpp"`
exposes the headers at `#include "format_handlers/SipiIOTiff.h"`; siblings
inside `cpp/` use the bare quote form.
"""

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//src:__subpackages__"])

# The codec-agnostic streaming write target (`"file"`/stdout/HTTP sink). A pure
# leaf — stdlib only, no SipiImage — that `SipiIO::write` returns through, so
# `//src/image`'s `SipiIO.h` includes it. Kept a separate target from
# `:format_handlers` so `//src/image` can depend on it WITHOUT depending on the handler
# package that in turn depends on `//src/image` (the cycle stays broken at target
# granularity: output_sink <- image <- format_handlers).
cc_library(
    name = "output_sink",
    srcs = ["cpp/output_sink.cpp"],
    hdrs = ["cpp/output_sink.h"],
    include_prefix = "format_handlers",
    strip_include_prefix = "/src/format_handlers/cpp",
)

cc_library(
    name = "format_handlers",
    srcs = [
        "cpp/SipiIOJ2k.cpp",
        "cpp/SipiIOJpeg.cpp",
        "cpp/SipiIOPng.cpp",
        "cpp/SipiIOTiff.cpp",
        "cpp/format_registry.cpp",
    ],
    hdrs = [
        "cpp/SipiIOJ2k.h",
        "cpp/SipiIOJpeg.h",
        "cpp/SipiIOPng.h",
        "cpp/SipiIOTiff.h",
    ],
    copts = ["-fexceptions"],
    include_prefix = "format_handlers",
    strip_include_prefix = "/src/format_handlers/cpp",
    deps = [
        ":output_sink",
        "//src:sipi_generated_hdrs",
        "//src/error",
        "//src/image",
        "//src/image_processing",
        "//src/logging:logging",
        "//src/metadata:metadata",
        "//src/observability:observability",
        "//src/util",
        "@bzip2//:bz2",
        "@curl",
        "@highway//:hwy",
        "@jansson//:jansson",
        "@kakadu//:kdu",
        "@libexpat",
        "@libjpeg_turbo//:jpeg",
        "@libmagic//:lib",
        "@libpng//:png",
        "@openssl//:crypto",
        "@openssl//:ssl",
        "@tiff//:tiff",
        "@xz//:lzma",
        "@zlib",
        "@zstd",
    ] + select({
        "@platforms//os:linux": ["//bazel:glibc23_compat"],
        "//conditions:default": [],
    }),
)

# Decode tier — SipiImage::read() across the @sipi_bench_fixtures input-format
# matrix. Co-located with the module per ADR-0003 (moved from //src with the
# format_handlers carve). Built only by `just bench` (`tags = ["manual"]`).
cc_binary(
    name = "decode_benchmark",
    srcs = ["cpp/decode_benchmark.cpp"],
    data = ["@sipi_bench_fixtures//:images"],
    tags = ["manual"],
    testonly = True,
    deps = [
        "//src:sipi_lib",
        "@google_benchmark//:benchmark_main",
    ],
)

# Encode tier — SipiImage::write() across the four emitted formats. SOURCE_DATE_EPOCH
# pins the wall-clock-stamped ICC creation date in emitted headers (ADR-0002).
cc_binary(
    name = "encode_benchmark",
    srcs = ["cpp/encode_benchmark.cpp"],
    data = ["@sipi_bench_fixtures//:images"],
    env = {
        "SIPI_WORKSPACE_ROOT": ".",
        "SOURCE_DATE_EPOCH": "946684800",
    },
    tags = ["manual"],
    testonly = True,
    deps = [
        "//src:sipi_lib",
        "//test:test_paths",
        "@google_benchmark//:benchmark_main",
    ],
)

# Colocated unit tests (ADR-0003). Covers TIFF pyramid-level selection plus
# the per-format `read`/`read_shape`/`write` regression suites (bilevel TIFF,
# JPEG marker parsing + write, J2K palette + oversized-dimension decode, the
# shared `SipiImgInfo`/`read_shape` surface across all four handlers, and the
# error paths each codec throws on truncated/malformed input).
cc_test(
    name = "formats_test",
    srcs = [
        "cpp/format_error_path_test.cpp",
        "cpp/imginfo_test.cpp",
        "cpp/j2k_dimension_regression_test.cpp",
        "cpp/j2k_palette_regression_test.cpp",
        "cpp/jpeg_format_regression_test.cpp",
        "cpp/jpeg_marker_regression_test.cpp",
        "cpp/jpeg_write_test.cpp",
        "cpp/select_pyramid_level_test.cpp",
        "cpp/tiff_bilevel_regression_test.cpp",
    ],
    data = ["//test/_test_data:images"],
    env = {"SIPI_WORKSPACE_ROOT": "."},
    deps = [
        ":format_handlers",
        "//test:test_paths",
        "@googletest//:gtest_main",
    ],
)

# The codec-agnostic write sink (`OutputSink` / `SinkStream`), linking the leaf.
cc_test(
    name = "output_sink_test",
    srcs = ["cpp/output_sink_test.cpp"],
    deps = [
        ":output_sink",
        "@googletest//:gtest_main",
    ],
)
