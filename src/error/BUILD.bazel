"""src/error — the SipiError exception base.

`metadata`, `formats`, and `iiifparser` all throw/catch `SipiError` without
depending on the image engine; folding the type into `//src/image` would
close an `image -> metadata -> image` cycle Bazel cannot express. This
package is the tree's foundational leaf: everything above it (`metadata`,
`formats`, `iiifparser`, the image engine) depends on it, and it depends on
nothing above itself.

`include_prefix = "error"` + `strip_include_prefix = "/src/error/cpp"`
exposes the header at `#include "error/SipiError.h"` for cross-package
consumers; the sibling inside this package uses the bare quote form
(`#include "SipiError.h"`).
"""

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//src:__subpackages__"])

cc_library(
    name = "error",
    srcs = ["cpp/SipiError.cpp"],
    hdrs = ["cpp/SipiError.h"],
    include_prefix = "error",
    strip_include_prefix = "/src/error/cpp",
    deps = [
        "//src/util",
    ],
)
