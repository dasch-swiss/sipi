"""src/observability/ — operational telemetry surface (Y+8L per DEV-6353).

First per-probe Bazel package promotion. Houses SIPI's metrics singleton
(`Sipi::observability::Metrics`) — plain atomic counters/gauges whose scalar
fields cross the FFI seam as `SipiMetricsSnapshot` (see `//src/ffi:sipi_ffi`)
and are exported over OTLP by the Rust shell. Crash/error reporting (Sentry) is
Rust-owned (DEV-6659) — the engine links no Sentry SDK; handled image errors
cross the FFI seam as `SipiImageErrorReport`, flattened from
`Sipi::observability::ImageContext` (`//src:populate_from_image.h`, not this
package — it dereferences `SipiImage`, which this package doesn't depend on).

Co-locates the `metrics_registry_test.cpp` seam tripwire per ADR-0003.

`layering_check` and `parse_headers` are **deferred** until SipiImage moves
into its own package (DEV-6388 / DEV-6395).
"""

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//src:__subpackages__"])

cc_library(
    name = "observability",
    srcs = [
        "metrics.cpp",
    ],
    hdrs = [
        "metrics.h",
        # The Tracy zone-macro shim. Header-only; the `@tracy//:tracy` dep below
        # propagates the (inert-unless-`--config=tracy`) profiler to every
        # //src:sipi_lib TU that `#include "observability/profiling.h"`.
        "profiling.h",
    ],
    # No `includes` directive needed: cross-module consumers use the
    # path-prefixed form (`#include "observability/metrics.h"`) which is
    # resolved via a consumer's own `includes = ["."]` (typically via
    # //src:sipi_lib). Siblings inside this package use the quote-form
    # (`#include "metrics.h"`) which searches the current source's
    # directory automatically.
    deps = [
        "//include:headers",
        "//src:sipi_generated_hdrs",
        # Profiler shim (profiling.h). Inert unless `--config=tracy` defines
        # TRACY_ENABLE; see bazel/tracy.BUILD.bazel.
        "@tracy//:tracy",
    ],
)

# The seam tripwire: pins every metric field against a classification of
# how (or whether) it reaches production OTLP. A failure here means "decide how
# your new metric crosses the seam" (the `SipiMetricsSnapshot` scalar bridge).
cc_test(
    name = "metrics_registry_test",
    srcs = [
        "metrics_registry_test.cpp",
        "test_main.cpp",
    ],
    deps = [
        ":observability",
        "@googletest//:gtest_main",
    ],
)
